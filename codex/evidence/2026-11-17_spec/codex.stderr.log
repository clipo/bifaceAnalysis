+options(width=140, digits=12)
+library(imager)
+cat('AUDIT environment\n',R.version.string,'\n')
+for(p in c('Momocs','imager','shiny','bslib','ggplot2','cluster','testthat')) cat(p,as.character(packageVersion(p)),'\n')
