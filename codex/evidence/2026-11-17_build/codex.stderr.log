+source("../bifaceAnalysis/R/report.R")
+ev<-"evidence/2026-11-17_build"
+cover<-c("AUDIT_START",sprintf("Specimen %03d: threshold 0.5, artifact lighter than background, speck removal 3 px, tip left, automatic tip and base, whole image, no scale.",1:40),"AUDIT_END")
+write_report(file.path(ev,"data/large_report.pdf"),cover,list())
+lines<-unlist(lapply(cover,function(p)c(strwrap(p,width=112),"")))
+cat("Cover paragraphs",length(cover),"lines",length(lines),"text height inches",length(lines)*.165+.2,"available page layout inches 10\n")
+system2("pdftotext",c("-layout",file.path(ev,"data/large_report.pdf"),file.path(ev,"data/large_report.txt")))
+ex<-readLines(file.path(ev,"data/large_report.txt"),warn=FALSE)
+ids<-as.integer(substr(ex[grepl("^Specimen",ex)],10,12))
+cat("Extracted specimen records",length(ids),"first",min(ids),"last",max(ids),"start marker",any(grepl("AUDIT_START",ex)),"end marker",any(grepl("AUDIT_END",ex)),"\n")
+source("../bifaceAnalysis/R/shape.R")
+x<-matrix(-2:2,ncol=1);cat("RV deterministic quadratic",rv_coefficient(x,x^2),"\n")
+perms<-function(x) if(length(x)==1)list(x)else unlist(lapply(seq_along(x),function(i)lapply(perms(x[-i]),function(z)c(x[i],z))),recursive=FALSE)
+a<-matrix(1:4,ncol=1); b<-diag(4)
+cat("Same n=4 exact permutation reference means: rank1",mean(sapply(perms(1:4),function(p)rv_coefficient(a,a[p,,drop=FALSE]))),"isotropic",mean(sapply(perms(1:4),function(p)rv_coefficient(b,b[p,,drop=FALSE]))),"\n")
