index 0000000000000000000000000000000000000000..1f57b7d40d392044a88f108bb21d6b81e24c87bb
--- /dev/null
+++ b/codex/evidence/2026-11-17_build/state_checks.R
@@ -0,0 +1,47 @@
+root <- normalizePath("..")
+ev <- normalizePath("evidence/2026-11-17_build")
+APP_DIR <- file.path(root,"bifaceAnalysis")
+for(f in list.files(file.path(APP_DIR,"R"),full.names=TRUE)) source(f)
+# Load only the five helper definitions, not the test cases.
+ex <- parse(file.path(root,"tests/testthat/test-server.R"))
+for(i in 1:5) eval(ex[[i]])
+setwd(APP_DIR)
+shiny::testServer(shiny::shinyAppDir(APP_DIR), {
+  do.call(session$setInputs,defaults); session$elapse(300)
+  session$setInputs(mode="scale",scale_mm=10,img_click=list(x=10,y=30))
+  session$setInputs(img_click=list(x=110,y=30),scale_all=TRUE)
+  cat("Before clear own/current/shared",own_ppm(),current_ppm(),rv$shared_ppm,"\n")
+  session$setInputs(clear_scale=1)
+  cat("After clear own/current/shared",own_ppm(),current_ppm(),rv$shared_ppm,"\n")
+  session$setInputs(scale_all=FALSE,next_img=1)
+  cat("Shared unchecked next image current",current_ppm(),"\n")
+  session$setInputs(prev_img=1)
+  p<-processed(); bb<-apply(p$outline_plot,2,range)
+  session$setInputs(mode="crop",img_brush=list(xmin=0,xmax=240,ymin=70,ymax=170))
+  before<-state()
+  session$setInputs(image_source="upload",images=data.frame(name="artifact1.jpg",datapath=file.path(APP_DIR,"www/artifact4.jpg")))
+  session$elapse(300)
+  cat("New source reused id",current_id(),"state identical",identical(before,state()),"image width",current_image()$width,"crop",state()$crop,"\n")
+  session$setInputs(images=data.frame(name="artifact1.jpg",datapath=file.path(APP_DIR,"www/artifact2.jpg")))
+  cat("Replacement upload state identical",identical(before,state()),"\n")
+  session$setInputs(clear_crop=1); session$elapse(300)
+  p<-processed()
+  session$setInputs(mode="landmarks",img_click=list(x=p$tip_plot[1],y=p$tip_plot[2]))
