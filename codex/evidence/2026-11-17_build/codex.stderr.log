   167	merge_specimens <- function(store, loaded) {
   168	  for (s in loaded) {
   169	    id <- s$id
   170	    if (!is.null(store[[id]]) && !isTRUE(all.equal(store[[id]]$outline, s$outline, tolerance = 1e-9))) {
   171	      k <- 2L
   172	      while (!is.null(store[[paste0(id, " #", k)]])) k <- k + 1L
   173	      id <- paste0(id, " #", k)
   174	      s$id <- id
   175	    }
   176	    s$name <- unique_specimen_name(s$name, store[setdiff(names(store), id)])
   177	    store[[id]] <- s
   178	  }
   179	  store
   180	}
   181	
   182	# `name`, or `name (2)`, `name (3)`, ... if other specimens already use it.
   183	unique_specimen_name <- function(name, others) {
   184	  taken <- vapply(others, function(s) s$name, character(1))
   185	  name <- trimws(name)
   186	  if (!nzchar(name)) name <- "specimen"
   187	  stem <- name; i <- 2L
   188	  while (name %in% taken) { name <- sprintf("%s (%d)", stem, i); i <- i + 1L }
   189	  name
   190	}

