+  q <- o[c(2:nrow(o),1),]; v <- q-o
+  t <- pmax(0,pmin(1,rowSums(sweep(o,2,p,"-") * -v)/rowSums(v*v)))
+  min(sqrt(rowSums(sweep(o+t*v,2,p,"-")^2)))
