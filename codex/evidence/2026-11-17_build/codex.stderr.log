+  if(case=="inf") df$x[3]<-Inf
+  if(case=="zero_tip_base") {df$x<-c(0,1,2,1,0,0,-1,-2,-1,0);df$y<-c(0,1,0,-1,-.5,0,1,0,-1,-.5)}
