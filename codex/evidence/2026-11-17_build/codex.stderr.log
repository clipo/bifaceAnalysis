+cat("RV scaled nonconstant block",rv_coefficient(matrix(1:20,4),matrix(1:20,4)),rv_coefficient(matrix(1:20,4)*1e-8,matrix(1:20,4)*1e-8),"\n")
+
+# A numeric, finite, nonzero-length but collinear imported contour.
