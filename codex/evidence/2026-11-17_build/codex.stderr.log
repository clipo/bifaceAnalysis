   196	       tip = pts[TIP_INDEX, ], base = pts[BASE_INDEX, ],
   197	       tip_input = back(pts[TIP_INDEX, ]), base_input = back(pts[BASE_INDEX, ]),
   198	       axis = u, warnings = warnings)
   199	}
   200	
   201	# Cross-section width at `n_levels` heights: the midpoints of equal slices of
   202	# the length. `height` is the fraction of length above the lowest point.
   203	width_profile <- function(outline, n_levels = 200L) {
   204	  yr <- range(outline[, 2])
   205	  levels <- yr[1] + (seq_len(n_levels) - 0.5) / n_levels * diff(yr)
   206	  data.frame(height = (levels - yr[1]) / diff(yr),
   207	             width = vapply(levels, function(l) cross_section_width(outline, l), numeric(1)))
   208	}
   209	
   210	# Linear measurements of an oriented outline (tip up), in the outline's pixel
   211	# units and in millimetres when px_per_mm is given.
   212	#   length: extent along the axis; width: extent at right angles to it;
   213	#   widest_position: height of the widest cross-section as a fraction of length
   214	#   above the lowest point (ties go to the level nearest the base).
   215	measure_outline <- function(outline, px_per_mm = NA_real_) {
   216	  len <- diff(range(outline[, 2]))
   217	  wid <- diff(range(outline[, 1]))
   218	  prof <- width_profile(outline)
   219	  area <- abs(polygon_moments(outline)$area)
   220	  s <- if (length(px_per_mm) == 1L && is.finite(px_per_mm) && px_per_mm > 0) px_per_mm else NA_real_
   221	  data.frame(
   222	    length_px = len, width_px = wid, area_px2 = area,
   223	    length_mm = len / s, width_mm = wid / s, area_mm2 = area / s^2,
   224	    length_width_ratio = len / wid,
   225	    widest_position = prof$height[which.max(round(prof$width, 9))]

