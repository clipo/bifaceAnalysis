+  text(rbind(p$tip_plot,p$base_plot),c("T","B"),col="cyan",cex=1.5)
+}
+dev.off()
+
+# Midline base at the second endpoint: a symmetric basal notch.
+notch <- rbind(c(0,10),c(-3,0),c(-2,-3),c(0,-1),c(2,-3),c(3,0))
