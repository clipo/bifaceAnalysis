# Image loading, the per-image processing wrapper, specimen records, and the
# CSV form of the specimen store.
# Specification: docs/specs/2026-11-17_app_rewrite_spec.md, sections 6.1, 6.5.

SCHEMA_VERSION <- 1L
CSV_COLUMNS <- c("schema_version", "id", "specimen", "group", "px_per_mm", "base_row",
                 "threshold", "polarity", "speck", "direction", "manual_landmarks", "cropped",
                 "row", "x", "y")

# Load an image for processing, resized so its longer side is at most
# `max_side` pixels. Returns list(gray (matrix [x, y], values 0..1), raster,
# width, height, factor), where factor is working pixels per original pixel.
load_working_image <- function(path, max_side = 1200L) {
  im <- imager::load.image(path)
  if (imager::depth(im) > 1L) im <- imager::frame(im, 1)
  if (imager::spectrum(im) == 4L) im <- imager::rm.alpha(im)
  if (imager::spectrum(im) == 2L) im <- imager::channel(im, 1)
  if (max(im) > 1) im <- im / 255
  w <- imager::width(im); h <- imager::height(im)
  factor <- 1
  if (max(w, h) > max_side) {
    factor <- max_side / max(w, h)
    im <- imager::resize(im, round(w * factor), round(h * factor), interpolation_type = 3)
    im[im < 0] <- 0; im[im > 1] <- 1
  }
  gray <- if (imager::spectrum(im) == 3L) imager::grayscale(im) else im
  list(gray = as.matrix(gray[, , 1, 1]), raster = grDevices::as.raster(im),
       width = imager::width(im), height = imager::height(im), factor = factor)
}

# Process one image region.
#   crop:      c(x1, x2, y1, y2) in plot coordinates (pixel i spans i-1..i), or NULL
#   tip, base: optional manual landmarks in plot coordinates
# Returns a list with ok and warnings, and, when ok, the outline in plot
# coordinates, the standardized result, the landmarks in plot coordinates, and
# the settings used.
process_image <- function(img, crop = NULL, threshold = NULL, polarity = "auto", speck_side = 3L,
                          direction = "up", tip = NULL, base = NULL) {
  w <- img$width; h <- img$height
  whole <- c(0, w, 0, h)
  if (is.null(crop)) crop <- whole
  xi <- seq(max(1L, floor(crop[1]) + 1L), min(w, ceiling(crop[2])))
  yi <- seq(max(1L, floor(crop[3]) + 1L), min(h, ceiling(crop[4])))
  if (length(xi) < 20L || length(yi) < 20L)
    return(list(ok = FALSE, warnings = "The crop is too small. Drag a larger rectangle around the artifact."))
  seg <- segment_image(img$gray[xi, yi, drop = FALSE], threshold, polarity, speck_side)
  if (is.null(seg$mask)) return(list(ok = FALSE, warnings = seg$warnings, threshold = seg$threshold))
  o <- mask_outline(seg$mask)
  if (is.null(o) || nrow(o) < 100L)
    return(list(ok = FALSE, threshold = seg$threshold,
                warnings = c(seg$warnings, "The detected outline has fewer than 100 points, which is too small to analyse. Use a larger image of the artifact or adjust the threshold.")))
  # Pixel index i has its centre at plot coordinate i - 0.5.
  o <- cbind(x = o[, 1] + xi[1] - 1.5, y = o[, 2] + yi[1] - 1.5)
  flip <- function(p) if (is.null(p)) NULL else c(p[1], -p[2])
  std <- tryCatch(standardize_outline(prepare_outline(o), direction, flip(tip), flip(base)),
                  error = function(e) e)
  if (inherits(std, "error"))
    return(list(ok = FALSE, threshold = seg$threshold, outline_plot = o,
                warnings = c(seg$warnings, conditionMessage(std))))
  list(ok = TRUE, warnings = c(seg$warnings, std$warnings), outline_plot = o, std = std,
       threshold = seg$threshold, polarity = seg$polarity,
       tip_plot = c(std$tip_input[1], -std$tip_input[2]),
       base_plot = c(std$base_input[1], -std$base_input[2]),
       settings = list(threshold = seg$threshold, polarity = seg$polarity, speck = as.integer(speck_side),
                       direction = direction, manual_landmarks = !is.null(tip) && !is.null(base),
                       cropped = !isTRUE(all.equal(as.numeric(crop), whole))))
}

# Scale conversion between working pixels (after resizing) and original pixels
# of an image whose resize factor is `factor` (working / original). A shared
# scale is held in original pixels per millimetre so that it transfers between
# images resized by different factors.
ppm_to_original <- function(ppm_working, factor) ppm_working / factor
ppm_to_working <- function(ppm_original, factor) ppm_original * factor

# A specimen record. `outline` is the oriented contour (tip up, tip first) in
# working pixels of its image; `base_row` is the row of the base landmark. The
# corresponding points are derived from the contour.
new_specimen <- function(id, name, group, outline, base_row, px_per_mm = NA_real_, settings = list()) {
  outline <- cbind(x = outline[, 1], y = outline[, 2])
  list(id = id, name = name, group = group, outline = outline, base_row = as.integer(base_row),
       points = points_from_outline(outline, as.integer(base_row)),
       px_per_mm = if (is.null(px_per_mm) || !is.finite(px_per_mm)) NA_real_ else px_per_mm,
       settings = settings)
}

# One row of measurements per specimen.
specimen_measurements <- function(specimens) {
  if (length(specimens) == 0L) return(NULL)
  pair <- mirror_index()
  out <- do.call(rbind, lapply(specimens, function(s) {
    cbind(data.frame(specimen = s$name, group = s$group, stringsAsFactors = FALSE),
          measure_outline(s$outline, s$px_per_mm),
          px_per_mm = s$px_per_mm,
          asymmetry = asymmetry_score(s$points, pair))
  }))
  rownames(out) <- NULL
  out
}

# Data frame in schema version 1: one row per contour vertex.
specimens_to_csv <- function(specimens) {
  val <- function(x, default) if (is.null(x)) default else x
  out <- do.call(rbind, lapply(specimens, function(s) {
    st <- s$settings
    data.frame(schema_version = SCHEMA_VERSION, id = s$id, specimen = s$name, group = s$group,
               px_per_mm = s$px_per_mm, base_row = s$base_row,
               threshold = val(st$threshold, NA_real_), polarity = val(st$polarity, NA_character_),
               speck = val(st$speck, NA_integer_), direction = val(st$direction, NA_character_),
               manual_landmarks = val(st$manual_landmarks, NA), cropped = val(st$cropped, NA),
               row = seq_len(nrow(s$outline)), x = s$outline[, 1], y = s$outline[, 2],
               stringsAsFactors = FALSE)
  }))
  rownames(out) <- NULL
  out
}

# Read specimens from a schema version 1 CSV. Stops with a plain message when
# the file is not in that form. Returns a list of specimen records named by id.
specimens_from_csv <- function(path, max_specimens = 500L) {
  # Read everything as text first so that a file with other columns is
  # rejected by the column check and not by a type conversion.
  df <- tryCatch(utils::read.csv(path, stringsAsFactors = FALSE, colClasses = "character", na.strings = character(0)),
                 error = function(e) NULL)
  if (!is.null(df) && all(CSV_COLUMNS %in% names(df))) {
    text_cols <- c("id", "specimen", "group")
    for (col in setdiff(names(df), text_cols)) {
      v <- df[[col]]
      v[v %in% c("", "NA")] <- NA
      df[[col]] <- utils::type.convert(v, as.is = TRUE)
    }
  }
  if (is.null(df) || !all(CSV_COLUMNS %in% names(df)))
    stop("This file is not an outline file saved by this app. It must contain the columns: ",
         paste(CSV_COLUMNS, collapse = ", "), ".")
  if (nrow(df) == 0L) stop("The outline file contains no rows.")
  if (any(is.na(df$schema_version)) || any(df$schema_version != SCHEMA_VERSION))
    stop("This outline file has a schema version this app cannot read. Expected version ", SCHEMA_VERSION, ".")
  if (!is.numeric(df$x) || !is.numeric(df$y) || anyNA(df$x) || anyNA(df$y))
    stop("The x and y columns of the outline file must contain only numbers.")
  df$group[is.na(df$group)] <- ""
  ids <- unique(df$id)
  if (length(ids) > max_specimens) stop("The outline file holds more than ", max_specimens, " specimens.")
  na_null <- function(v) if (length(v) == 0L || is.na(v)) NULL else v
  out <- lapply(ids, function(id) {
    d <- df[df$id == id, , drop = FALSE]
    d <- d[order(d$row), , drop = FALSE]
    base_row <- suppressWarnings(as.integer(d$base_row[1]))
    if (nrow(d) < 10L || is.na(base_row) || base_row < 2L || base_row > nrow(d))
      stop("Specimen '", d$specimen[1], "' in the outline file has an incomplete outline.")
    settings <- list(threshold = na_null(suppressWarnings(as.numeric(d$threshold[1]))),
                     polarity = na_null(as.character(d$polarity[1])),
                     speck = na_null(suppressWarnings(as.integer(d$speck[1]))),
                     direction = na_null(as.character(d$direction[1])),
                     manual_landmarks = na_null(as.logical(d$manual_landmarks[1])),
                     cropped = na_null(as.logical(d$cropped[1])))
    new_specimen(id, d$specimen[1], d$group[1], cbind(d$x, d$y), base_row,
                 suppressWarnings(as.numeric(d$px_per_mm[1])), settings[!vapply(settings, is.null, logical(1))])
  })
  stats::setNames(out, ids)
}

# Merge loaded specimens into a store (both lists named by id). A loaded
# specimen whose id exists replaces the stored one when their contours are
# identical, and otherwise is added under a new id. Display names are made
# unique.
merge_specimens <- function(store, loaded) {
  for (s in loaded) {
    id <- s$id
    if (!is.null(store[[id]]) && !isTRUE(all.equal(store[[id]]$outline, s$outline, tolerance = 1e-9))) {
      k <- 2L
      while (!is.null(store[[paste0(id, " #", k)]])) k <- k + 1L
      id <- paste0(id, " #", k)
      s$id <- id
    }
    s$name <- unique_specimen_name(s$name, store[setdiff(names(store), id)])
    store[[id]] <- s
  }
  store
}

# `name`, or `name (2)`, `name (3)`, ... if other specimens already use it.
unique_specimen_name <- function(name, others) {
  taken <- vapply(others, function(s) s$name, character(1))
  name <- trimws(name)
  if (!nzchar(name)) name <- "specimen"
  stem <- name; i <- 2L
  while (name %in% taken) { name <- sprintf("%s (%d)", stem, i); i <- i + 1L }
  name
}
# One plotting function per figure. Each returns a ggplot object that is used
# for both the screen and the PDF report. Figures carry no titles.

OKABE_ITO <- c("#0072B2", "#E69F00", "#009E73", "#CC79A7", "#D55E00", "#56B4E9", "#F0E442", "#000000")
REGION_COLOURS <- c(Tip = "#D55E00", Blade = "#0072B2", Shoulder = "#009E73", Base = "#CC79A7")

theme_app <- function(base_size = 13) {
  ggplot2::theme_minimal(base_size = base_size, base_family = "sans") +
    ggplot2::theme(panel.grid.minor = ggplot2::element_blank(),
                   panel.grid.major = ggplot2::element_line(colour = "grey92"),
                   legend.position = "bottom")
}

theme_shape <- function(base_size = 13) {
  ggplot2::theme_void(base_size = base_size, base_family = "sans") +
    ggplot2::theme(legend.position = "bottom",
                   strip.text = ggplot2::element_text(size = base_size * 0.85))
}

category_scale <- function(values, aesthetic = "colour", name = NULL) {
  lv <- levels(factor(values))
  cols <- stats::setNames(rep(OKABE_ITO, length.out = length(lv)), lv)
  ggplot2::scale_discrete_manual(aesthetics = aesthetic, values = cols, name = name)
}

closed <- function(m) rbind(m, m[1, , drop = FALSE])

shapes_frame <- function(shapes) {
  do.call(rbind, lapply(names(shapes), function(n) {
    m <- closed(shapes[[n]])
    data.frame(specimen = n, x = m[, 1], y = m[, 2], stringsAsFactors = FALSE)
  }))
}

path_frame <- function(m) {
  m <- closed(m)
  data.frame(x = m[, 1], y = m[, 2])
}

has_labels <- function(groups) !is.null(groups) && any(nzchar(as.character(groups)))

# Each specimen's oriented outline, drawn to a common height.
plot_outline_grid <- function(outlines, groups = NULL) {
  norm <- lapply(outlines, function(o) {
    o <- sweep(o, 2, c(mean(range(o[, 1])), min(o[, 2])))
    o / max(o[, 2])
  })
  df <- shapes_frame(norm)
  df$specimen <- factor(df$specimen, levels = names(outlines))
  df$group <- if (has_labels(groups)) groups[match(df$specimen, names(outlines))] else "all"
  p <- ggplot2::ggplot(df, ggplot2::aes(x, y, group = specimen, fill = group)) +
    ggplot2::geom_polygon(colour = "grey20", linewidth = 0.4, alpha = 0.55) +
    ggplot2::facet_wrap(~specimen) + ggplot2::coord_equal() + theme_shape()
  if (has_labels(groups)) p + category_scale(df$group, "fill", "Group")
  else p + ggplot2::scale_fill_manual(values = c(all = "grey75"), guide = "none")
}

# All aligned shapes overlaid, with the mean shape in black.
plot_outline_stack <- function(aligned, mean_shape, groups = NULL) {
  df <- shapes_frame(aligned)
  df$group <- if (has_labels(groups)) groups[match(df$specimen, names(aligned))] else "all"
  p <- ggplot2::ggplot(df, ggplot2::aes(x, y)) +
    ggplot2::geom_path(ggplot2::aes(group = specimen, colour = group), linewidth = 0.5, alpha = 0.7) +
    ggplot2::geom_path(data = path_frame(mean_shape), colour = "black", linewidth = 1.1) +
    ggplot2::coord_equal() + theme_shape()
  if (has_labels(groups)) p + category_scale(df$group, "colour", "Group")
  else p + ggplot2::scale_colour_manual(values = c(all = "grey55"), guide = "none")
}

# Length against maximum width, in millimetres when every specimen has a scale.
plot_measurements <- function(meas, groups = NULL) {
  use_mm <- all(is.finite(meas$length_mm))
  df <- data.frame(specimen = meas$specimen,
                   length = if (use_mm) meas$length_mm else meas$length_px,
                   width = if (use_mm) meas$width_mm else meas$width_px)
  unit <- if (use_mm) "mm" else "pixels"
  df$group <- if (has_labels(groups)) groups else "all"
  p <- ggplot2::ggplot(df, ggplot2::aes(width, length, colour = group, label = specimen)) +
    ggplot2::geom_point(size = 3) +
    ggplot2::geom_text(vjust = -0.9, size = 3.5, family = "sans", show.legend = FALSE) +
    ggplot2::scale_y_continuous(expand = ggplot2::expansion(mult = 0.12)) +
    ggplot2::scale_x_continuous(expand = ggplot2::expansion(mult = 0.12)) +
    ggplot2::labs(x = sprintf("Maximum width (%s)", unit), y = sprintf("Length (%s)", unit)) +
    theme_app()
  if (has_labels(groups)) p + category_scale(df$group, "colour", "Group")
  else p + ggplot2::scale_colour_manual(values = c(all = OKABE_ITO[1]), guide = "none")
}

# Share of the power beyond the first harmonic held by each harmonic (bars) and
# the cumulative share (line). The dashed line marks the number retained.
plot_harmonic_power <- function(power_table, n_used) {
  df <- power_table[-1, ]
  df$share <- diff(c(0, df$cumulative_excluding_first))
  ggplot2::ggplot(df, ggplot2::aes(harmonic)) +
    ggplot2::geom_col(ggplot2::aes(y = share), fill = OKABE_ITO[6], width = 0.8) +
    ggplot2::geom_line(ggplot2::aes(y = cumulative_excluding_first), colour = OKABE_ITO[5], linewidth = 0.8) +
    ggplot2::geom_point(ggplot2::aes(y = cumulative_excluding_first), colour = OKABE_ITO[5], size = 1.8) +
    ggplot2::geom_vline(xintercept = n_used + 0.5, linetype = "dashed", colour = "grey30") +
    ggplot2::scale_y_continuous(labels = function(v) paste0(round(100 * v), "%"), limits = c(0, 1.001)) +
    ggplot2::labs(x = "Harmonic", y = "Share of power beyond harmonic 1") +
    theme_app()
}

# One specimen rebuilt from increasing numbers of harmonics, over its outline.
plot_reconstruction <- function(shape, counts) {
  counts <- sort(unique(as.integer(counts)))
  full <- efa_forward(shape, max(counts))
  vec <- efa_vector(full)
  recs <- lapply(counts, function(h) efa_inverse(vec, 300L, h, full$x0, full$y0))
  names(recs) <- sprintf("%d harmonic%s", counts, ifelse(counts == 1, "", "s"))
  df <- shapes_frame(recs)
  df$specimen <- factor(df$specimen, levels = names(recs))
  ggplot2::ggplot(df, ggplot2::aes(x, y)) +
    ggplot2::geom_polygon(data = path_frame(shape), fill = "grey85", colour = NA) +
    ggplot2::geom_path(colour = OKABE_ITO[5], linewidth = 0.7) +
    ggplot2::facet_wrap(~specimen, nrow = 1) + ggplot2::coord_equal() + theme_shape()
}

plot_scree <- function(pca) {
  df <- data.frame(pc = seq_along(pca$explained), share = pca$explained)
  ggplot2::ggplot(df, ggplot2::aes(pc, share)) +
    ggplot2::geom_col(fill = OKABE_ITO[6], width = 0.7) +
    ggplot2::scale_x_continuous(breaks = df$pc) +
    ggplot2::scale_y_continuous(labels = function(v) paste0(round(100 * v), "%")) +
    ggplot2::labs(x = "Principal component", y = "Share of shape variance") + theme_app()
}

# Shape implied by a position in PC space (scores on the leading components),
# drawn centred (constant terms zero).
pc_shape <- function(pca, scores, n_points = 200L) {
  k <- seq_along(scores)
  efa_inverse(pca$center + as.numeric(pca$loadings[, k, drop = FALSE] %*% scores), n_points)
}

# PC scores with reconstructed shapes on a background grid.
plot_morphospace <- function(pca, colour_by = NULL, colour_name = NULL, axes = c(1L, 2L)) {
  sc <- pca$scores
  df <- data.frame(specimen = rownames(sc), a = sc[, axes[1]], b = sc[, axes[2]])
  df$colour <- if (has_labels(colour_by)) as.character(colour_by) else "all"
  pad <- function(r) { w <- diff(r); if (w == 0) w <- 1; r + c(-1, 1) * 0.18 * w }
  ra <- pad(range(df$a)); rb <- pad(range(df$b))
  ga <- seq(ra[1], ra[2], length.out = 5); gb <- seq(rb[1], rb[2], length.out = 4)
  cell <- min(diff(ga)[1], diff(gb)[1])
  bg <- do.call(rbind, lapply(ga, function(va) do.call(rbind, lapply(gb, function(vb) {
    s <- numeric(max(axes)); s[axes[1]] <- va; s[axes[2]] <- vb
    m <- closed(pc_shape(pca, s, 120L))
    m <- sweep(m, 2, colMeans(m))
    m <- m * 0.42 * cell / max(apply(m, 2, function(v) diff(range(v))))
    data.frame(id = paste(va, vb), x = va + m[, 1], y = vb + m[, 2])
  }))))
  lab <- function(i) sprintf("PC%d (%.0f%% of shape variance)", i, 100 * pca$explained[i])
  p <- ggplot2::ggplot() +
    ggplot2::geom_polygon(data = bg, ggplot2::aes(x, y, group = id), fill = "grey90", colour = "grey70", linewidth = 0.3) +
    ggplot2::geom_point(data = df, ggplot2::aes(a, b, colour = colour), size = 3) +
    ggplot2::geom_text(data = df, ggplot2::aes(a, b, label = specimen, colour = colour), vjust = -1, size = 3.5,
                       family = "sans", show.legend = FALSE) +
    ggplot2::coord_equal() + ggplot2::labs(x = lab(axes[1]), y = lab(axes[2])) + theme_app()
  if (has_labels(colour_by)) p + category_scale(df$colour, "colour", colour_name)
  else p + ggplot2::scale_colour_manual(values = c(all = OKABE_ITO[1]), guide = "none")
}

# Shapes at the mean and at -n_sd and +n_sd standard deviations on a component.
pc_extreme_shapes <- function(pca, pc, n_sd = 2) {
  s <- numeric(pc)
  lo <- s; lo[pc] <- -n_sd * pca$sdev[pc]
  hi <- s; hi[pc] <- n_sd * pca$sdev[pc]
  list(low = pc_shape(pca, lo), mean = pc_shape(pca, s), high = pc_shape(pca, hi))
}

# Mean, low-end, and high-end shapes for the first min(3, rank) components.
plot_pc_shapes <- function(pca) {
  pcs <- seq_len(min(3L, pca$rank))
  ends <- c("Low end (-2 SD)", "Mean", "High end (+2 SD)")
  df <- do.call(rbind, lapply(pcs, function(pc) {
    e <- pc_extreme_shapes(pca, pc)
    lab <- sprintf("PC%d (%.0f%%)", pc, 100 * pca$explained[pc])
    rbind(data.frame(pc = lab, end = ends[1], path_frame(e$low)),
          data.frame(pc = lab, end = ends[2], path_frame(e$mean)),
          data.frame(pc = lab, end = ends[3], path_frame(e$high)))
  }))
  df$end <- factor(df$end, levels = ends)
  ggplot2::ggplot(df, ggplot2::aes(x, y, colour = end, linetype = end, group = end)) +
    ggplot2::geom_path(linewidth = 0.9) +
    ggplot2::scale_colour_manual(values = stats::setNames(c(OKABE_ITO[1], "grey55", OKABE_ITO[5]), ends), name = NULL) +
    ggplot2::scale_linetype_manual(values = stats::setNames(c("solid", "dashed", "solid"), ends), name = NULL) +
    ggplot2::facet_wrap(~pc, nrow = 1) + ggplot2::coord_equal() + theme_shape()
}

# Leave-one-out agreement: the PC1-PC2 plane, and the direction of each
# component that is separable from its neighbours.
plot_stability <- function(stab) {
  df <- data.frame(left_out = names(stab$plane), quantity = "Plane of PC1 and PC2", value = stab$plane)
  for (a in names(stab$separable)[stab$separable])
    df <- rbind(df, data.frame(left_out = rownames(stab$axis), quantity = paste(a, "direction"), value = stab$axis[, a]))
  df$quantity <- factor(df$quantity, levels = unique(df$quantity))
  ggplot2::ggplot(df, ggplot2::aes(value, left_out)) +
    ggplot2::geom_segment(ggplot2::aes(x = 0, xend = value, yend = left_out), colour = "grey75") +
    ggplot2::geom_point(colour = OKABE_ITO[1], size = 2.5) +
    ggplot2::facet_wrap(~quantity, nrow = 1) + ggplot2::scale_x_continuous(limits = c(0, 1)) +
    ggplot2::labs(x = "Agreement with the full analysis (1 = unchanged)", y = "Specimen left out") + theme_app()
}

# Segment coordinates for drawing an hclust tree.
dendrogram_segments <- function(tree) {
  n <- length(tree$order)
  xpos <- numeric(n); xpos[tree$order] <- seq_len(n)
  node_x <- numeric(n - 1L); node_h <- tree$height
  segs <- vector("list", n - 1L)
  for (i in seq_len(n - 1L)) {
    ch <- tree$merge[i, ]
    cx <- ifelse(ch < 0, xpos[abs(ch)], node_x[pmax(ch, 1L)])
    chh <- ifelse(ch < 0, 0, node_h[pmax(ch, 1L)])
    node_x[i] <- mean(cx)
    segs[[i]] <- data.frame(x = c(cx[1], cx[2], cx[1]), xend = c(cx[1], cx[2], cx[2]),
                            y = c(chh[1], chh[2], node_h[i]), yend = rep(node_h[i], 3))
  }
  list(segments = do.call(rbind, segs), leaves = data.frame(x = seq_len(n), label = tree$labels[tree$order]))
}

# Tree with leaves coloured by cluster and a dashed line where it is cut.
plot_dendrogram <- function(tree, k) {
  d <- dendrogram_segments(tree)
  cl <- stats::cutree(tree, k)
  d$leaves$cluster <- factor(cl[d$leaves$label])
  h <- sort(tree$height, decreasing = TRUE)
  cut_h <- if (k >= 2 && k <= length(h)) mean(h[c(k - 1, k)]) else NA_real_
  p <- ggplot2::ggplot() +
    ggplot2::geom_segment(data = d$segments, ggplot2::aes(x = x, xend = xend, y = y, yend = yend), colour = "grey25") +
    ggplot2::geom_point(data = d$leaves, ggplot2::aes(x, 0, colour = cluster), size = 3) +
    ggplot2::scale_x_continuous(breaks = d$leaves$x, labels = d$leaves$label) +
    ggplot2::labs(x = NULL, y = "Distance at which groups merge") +
    category_scale(d$leaves$cluster, "colour", "Cluster") + theme_app() +
    ggplot2::theme(axis.text.x = ggplot2::element_text(angle = 45, hjust = 1),
                   panel.grid.major.x = ggplot2::element_blank())
  if (is.finite(cut_h)) p <- p + ggplot2::geom_hline(yintercept = cut_h, linetype = "dashed", colour = "grey40")
  p
}

plot_silhouette <- function(sil, k) {
  sil$chosen <- sil$k == k
  ggplot2::ggplot(sil, ggplot2::aes(k, silhouette, fill = chosen)) +
    ggplot2::geom_col(width = 0.7) +
    ggplot2::scale_fill_manual(values = c(`TRUE` = OKABE_ITO[5], `FALSE` = OKABE_ITO[6]), guide = "none") +
    ggplot2::scale_x_continuous(breaks = sil$k) +
    ggplot2::labs(x = "Number of clusters", y = "Mean silhouette width") + theme_app()
}

# Mean shape with points coloured by region.
plot_regions <- function(mean_shape, regions) {
  df <- data.frame(x = mean_shape[, 1], y = mean_shape[, 2], region = regions)
  ggplot2::ggplot(df, ggplot2::aes(x, y)) +
    ggplot2::geom_path(data = path_frame(mean_shape), colour = "grey60") +
    ggplot2::geom_point(ggplot2::aes(colour = region), size = 1.8) +
    ggplot2::scale_colour_manual(values = REGION_COLOURS, name = "Region", drop = FALSE) +
    ggplot2::coord_equal() + theme_shape()
}

# Mean shape with points coloured by their variance across specimens.
plot_point_variance <- function(mean_shape, variance) {
  df <- data.frame(x = mean_shape[, 1], y = mean_shape[, 2], variance = variance)
  ggplot2::ggplot(df, ggplot2::aes(x, y)) +
    ggplot2::geom_path(data = path_frame(mean_shape), colour = "grey60") +
    ggplot2::geom_point(ggplot2::aes(colour = variance), size = 2.2) +
    ggplot2::scale_colour_viridis_c(name = "Variance at each point", option = "viridis") +
    ggplot2::coord_equal() + theme_shape() +
    ggplot2::theme(legend.key.width = grid::unit(1.4, "cm"),
                   legend.text = ggplot2::element_text(angle = 45, hjust = 1))
}

plot_region_variance <- function(region_variance) {
  df <- data.frame(region = factor(names(region_variance), levels = names(region_variance)),
                   variance = as.numeric(region_variance))
  df <- df[is.finite(df$variance), ]
  ggplot2::ggplot(df, ggplot2::aes(region, variance, fill = region)) +
    ggplot2::geom_col(width = 0.7) +
    ggplot2::scale_fill_manual(values = REGION_COLOURS, guide = "none") +
    ggplot2::labs(x = NULL, y = "Mean variance per point") + theme_app()
}

# Observed RV for each pair of regions beside its re-pairing reference.
plot_region_rv <- function(rv_table) {
  rv_table <- rv_table[is.finite(rv_table$rv), ]
  rv_table$pair <- paste(rv_table$region_a, "and", rv_table$region_b)
  rv_table$pair <- factor(rv_table$pair, levels = rev(rv_table$pair))
  ggplot2::ggplot(rv_table, ggplot2::aes(y = pair)) +
    ggplot2::geom_linerange(ggplot2::aes(xmin = reference_low, xmax = reference_high, colour = "ref"), linewidth = 4, alpha = 0.5) +
    ggplot2::geom_point(ggplot2::aes(x = reference_mean, colour = "ref"), shape = 124, size = 5) +
    ggplot2::geom_point(ggplot2::aes(x = rv, colour = "obs"), size = 3.5) +
    ggplot2::scale_colour_manual(values = c(obs = OKABE_ITO[5], ref = "grey55"), name = NULL,
                                 labels = c(obs = "Observed RV", ref = "RV with specimens re-paired at random (mean and central 95% of values)")) +
    ggplot2::scale_x_continuous(limits = c(0, 1)) +
    ggplot2::labs(x = "RV coefficient", y = NULL) + theme_app() +
    ggplot2::theme(legend.direction = "vertical")
}
# Interpretation text. Each function returns a character vector of paragraphs
# built from the values it is given. Statements report what was computed and
# what the quantity measures. They make no archaeological claims and use no
# significance language.

fmt_pct <- function(x, digits = 0) paste0(formatC(100 * x, format = "f", digits = digits), "%")
fmt_num <- function(x, digits = 2) formatC(x, format = "f", digits = digits)
name_list <- function(x) {
  if (length(x) <= 1L) return(paste(x))
  paste(paste(x[-length(x)], collapse = ", "), "and", x[length(x)])
}

text_sample <- function(n) {
  out <- sprintf("This analysis uses %d specimen%s.", n, if (n == 1) "" else "s")
  if (n >= 3)
    out <- c(out, sprintf("With %d specimens, at most %d principal components can exist. Results from a small number of specimens describe those specimens and can change when specimens are added or removed.", n, n - 1L))
  out
}

text_outlines <- function(n, symmetrized) {
  c(text_sample(n)[1],
    "Each outline was turned so its tip points up, then divided at the tip and at the base into a left and a right edge. Each edge is represented by 100 points spaced evenly along its length, so point number 30, for example, is 30 percent of the way along the edge from the tip on every specimen.",
    "The overlay shows all specimens after Procrustes alignment, which removes differences in position, size, and rotation. What remains is difference in shape. The black line is the mean shape. Where the coloured lines spread apart, the specimens differ.",
    if (symmetrized) "The shapes shown were made symmetric by averaging each one with its mirror image. Measurements and saved outlines are not changed by this option." else
      "Left and right in these plots depend on which face of the artifact was photographed. Differences between the two edges are therefore not comparable from specimen to specimen unless every artifact was photographed with a consistent face up.")
}

text_measurements <- function(meas) {
  has_mm <- all(is.finite(meas$length_mm))
  out <- "Length is the extent of the outline along the tip-to-base axis. Maximum width is its extent at right angles to that axis. Both correspond to caliper measurements. The widest cross-section is located by measuring straight across the outline at 200 heights, and its height is given as a fraction of length above the base end."
  ratio <- sprintf("Length divided by width ranges from %s to %s.",
                   fmt_num(min(meas$length_width_ratio)), fmt_num(max(meas$length_width_ratio)))
  if (has_mm) {
    r <- range(meas$length_mm)
    out <- c(out, sprintf("Lengths range from %s to %s mm. %s", fmt_num(r[1], 1), fmt_num(r[2], 1), ratio))
  } else {
    out <- c(out, "At least one specimen has no scale, so lengths, widths, and areas are shown in image pixels. Pixel values depend on how each photograph was taken and cannot be compared between images. Ratios such as length divided by width do not depend on scale and can be compared.",
             ratio)
  }
  c(out, "The asymmetry score is the Procrustes distance between a shape and its own mirror image. It is 0 for a perfectly symmetric outline and increases as the two edges differ.",
    if (nrow(meas) > 1)
      sprintf("The most asymmetric specimen is %s (%s) and the least asymmetric is %s (%s).",
              meas$specimen[which.max(meas$asymmetry)], fmt_num(max(meas$asymmetry), 3),
              meas$specimen[which.min(meas$asymmetry)], fmt_num(min(meas$asymmetry), 3)))
}

text_harmonics <- function(power_table, n_used, automatic) {
  first <- power_table$cumulative_all[1]
  reached <- power_table$cumulative_excluding_first[n_used]
  c("Elliptical Fourier analysis describes a closed outline as a sum of harmonics. The first harmonic is an ellipse. Each later harmonic adds finer detail. The lower panel shows one specimen rebuilt from increasing numbers of harmonics.",
    sprintf("In these specimens the first harmonic holds %s of total power, because every outline is roughly an elongated oval. The chart therefore shows how the remaining power is divided among harmonics 2 and above.", fmt_pct(first, 1)),
    sprintf("The analysis uses %d harmonics (%s), which together hold %s of the power beyond the first harmonic. Too few harmonics discard real features such as notches and barbs. Many more add the pixel-level roughness of the outline to the analysis.",
            n_used, if (automatic) "chosen automatically as the smallest number that reaches 99%, within the limits 6 to 30" else "set by hand",
            fmt_pct(reached, 1)))
}

# Length/width ratio and widest position of a reconstructed (tip-up) shape.
shape_descriptors <- function(shape) {
  m <- measure_outline(shape)
  c(ratio = m$length_width_ratio, widest = m$widest_position)
}

text_pca <- function(pca, n) {
  ex <- pca$explained
  sc <- pca$scores
  ends <- function(i) sprintf("%s has the lowest score and %s the highest",
                              rownames(sc)[which.min(sc[, i])], rownames(sc)[which.max(sc[, i])])
  c("Principal component analysis finds the directions along which the specimens' shapes differ most. PC1 is the direction with the most variation, PC2 the direction with the most of what remains, and so on. Each point in the plot is one specimen. Specimens that plot close together have similar outlines.",
    sprintf("PC1 holds %s of the shape variance and PC2 holds %s, %s together. On PC1, %s. On PC2, %s.",
            fmt_pct(ex[1]), fmt_pct(ex[2]), fmt_pct(ex[1] + ex[2]), ends(1), ends(2)),
    "The grey shapes in the background show the outline that corresponds to each position in the plot. The distance between two specimens in this plot understates their full difference whenever later components hold a substantial share of the variance.",
    text_sample(n)[-1])
}

text_pc_shapes <- function(pca) {
  pcs <- seq_len(min(3L, pca$rank))
  desc <- vapply(pcs, function(pc) {
    e <- pc_extreme_shapes(pca, pc)
    lo <- shape_descriptors(e$low); hi <- shape_descriptors(e$high)
    sprintf("From the low end to the high end of PC%d, length divided by width goes from %s to %s, and the widest cross-section moves from %s to %s of the length above the base.",
            pc, fmt_num(lo["ratio"]), fmt_num(hi["ratio"]), fmt_pct(lo["widest"]), fmt_pct(hi["widest"]))
  }, character(1))
  c("Each panel shows the mean shape (dashed) and the shapes that correspond to scores 2 standard deviations below and above the mean on one component. Compare the two solid outlines to see which parts of the outline move along that component.",
    desc,
    "These two numbers summarize only part of each shape change. Look at the outlines for changes in the shoulders, barbs, and base. The plotted shapes are positions along a component, not real specimens, and with few specimens they can look unlike any artifact in the sample.")
}

text_stability <- function(stab) {
  worst <- which.min(stab$plane)
  out <- c("To show how much the components depend on individual specimens, the analysis was repeated with each specimen left out in turn, keeping the same alignment and number of harmonics. The plot compares each repeat with the full analysis. A value near 1 means the result was unchanged. A value well below 1 means that the specimen named on that row largely determines the result.",
           sprintf("For the plane containing PC1 and PC2, which is what the scatter plot shows, the lowest agreement is %s (when %s is left out) and the median is %s.",
                   fmt_num(min(stab$plane, na.rm = TRUE)), names(stab$plane)[worst], fmt_num(stats::median(stab$plane, na.rm = TRUE))))
  for (a in names(stab$separable)) {
    if (stab$separable[[a]]) {
      v <- stab$axis[, a]
      out <- c(out, sprintf("For the direction of %s alone, the lowest agreement is %s (when %s is left out).",
                            a, fmt_num(min(v, na.rm = TRUE)), rownames(stab$axis)[which.min(v)]))
    } else {
      out <- c(out, sprintf("%s holds a share of variance too close to a neighbouring component's for its direction to be distinguished reliably, so no separate value is shown for it. Components with similar shares can exchange order or rotate into each other when a specimen is removed. Read such components together, as a plane, and not one at a time.", a))
    }
  }
  out
}

text_clusters <- function(tree, k, sil, groups = NULL) {
  sizes <- table(stats::cutree(tree, k))
  out <- c("Hierarchical clustering (Ward's method) joins the most similar outlines first and then joins groups step by step. In the tree, the height at which two branches join is the dissimilarity between them. Cutting the tree at the dashed line gives the number of clusters you chose.",
           sprintf("With %d clusters, the cluster sizes are %s.", k, name_list(as.integer(sizes))))
  if (nrow(sil) > 0) {
    best <- sil$k[which.max(sil$silhouette)]
    out <- c(out, sprintf("Mean silhouette width measures how much closer specimens are to their own cluster than to the nearest other cluster, on a scale from -1 to 1. Values near 1 indicate compact, well separated clusters. Values near 0 or below indicate clusters that overlap. Here it is highest at %d clusters (%s) and is %s at your choice of %d.",
                          best, fmt_num(max(sil$silhouette)), fmt_num(sil$silhouette[sil$k == k]), k))
  }
  out <- c(out, "Clustering always produces clusters, including from data with no real groups. Treat clusters as a description of similarity in outline shape, to be compared with other information about the artifacts.")
  if (has_labels(groups))
    out <- c(out, "The table compares the clusters with the group labels you entered. If the labels correspond to outline shape, each cluster will contain mostly one label.")
  out
}

text_regions <- function(region_variance, rv_table, n, boundaries) {
  rvv <- region_variance[is.finite(region_variance)]
  b <- sort(boundaries)
  out <- c(sprintf("Each edge is divided by position along its length from the tip: tip from 0 to %s, blade to %s, shoulder to %s, and base from there to the base landmark. The same point numbers are used on every specimen. These divisions are proportional. They do not locate the actual shoulder or haft of each artifact, so check the region plot against your specimens and adjust the boundaries if needed.",
                   fmt_pct(b[1]), fmt_pct(b[2]), fmt_pct(b[3])))
  if (length(rvv) >= 2 && min(rvv) > 0)
    out <- c(out, sprintf("Variance per point is highest in the %s region and lowest in the %s region, a ratio of %s to 1. This measures how much specimens differ from one another in that part of the outline after alignment.",
                          tolower(names(rvv)[which.max(rvv)]), tolower(names(rvv)[which.min(rvv)]), fmt_num(max(rvv) / min(rvv), 1)))
  out <- c(out, "Procrustes alignment fits whole outlines to each other, so a large difference in one part of the outline is partly spread to the other parts. The variance at a point reflects that overall fit and not only the local difference at that point.")
  if (!is.null(rv_table)) rv_table <- rv_table[is.finite(rv_table$rv), , drop = FALSE]
  if (!is.null(rv_table) && nrow(rv_table) > 0) {
    top <- rv_table[which.max(rv_table$rv), ]
    above <- rv_table$rv > rv_table$reference_high
    out <- c(out,
             "The RV coefficient measures how much two regions vary together across specimens, from 0 (the shapes of the two regions are unrelated) to 1 (the specimens differ from one another in the same pattern in both regions).",
             sprintf("The highest observed value is %s, between the %s and the %s.", fmt_num(top$rv), tolower(top$region_a), tolower(top$region_b)),
             sprintf("RV is large for small samples even when regions are unrelated. The grey bars show the values obtained when each specimen's coordinates for one region were paired at random with another specimen's coordinates for the other region. With %d specimens, %s. An observed value inside the grey bar is no larger than values that arise from arbitrary pairing.",
                     n, if (any(above)) sprintf("the observed value lies above the grey bar for %d of %d pairs of regions", sum(above), nrow(rv_table)) else "no observed value lies above its grey bar"),
             if (n <= 5) sprintf("With %d specimens there are only %d distinct ways to pair them, so the grey bars are coarse.", n, as.integer(factorial(n))),
             "The grey bar is a reference for sample size only. It is not a margin of error for the observed value. The random pairing reuses the same aligned coordinates, so it does not remove shared variation that the alignment of whole outlines itself produces. Treat these values as descriptions, not as evidence of how the artifacts were made or used.")
  }
  out
}
# PDF report: the figures shown on screen with their interpretation text.

report_page <- function(heading, plot = NULL, paragraphs = character(0)) {
  grid::grid.newpage()
  lines <- unlist(lapply(paragraphs, function(p) c(strwrap(p, width = 112), "")))
  text_height <- grid::unit(if (length(lines)) length(lines) * 0.165 + 0.2 else 0, "inches")
  lay <- grid::grid.layout(3, 1, heights = grid::unit.c(grid::unit(0.5, "inches"), grid::unit(1, "null"), text_height))
  grid::pushViewport(grid::viewport(width = grid::unit(7.3, "inches"), height = grid::unit(10, "inches"), layout = lay))
  grid::pushViewport(grid::viewport(layout.pos.row = 1))
  grid::grid.text(heading, x = 0, just = "left", gp = grid::gpar(fontsize = 15, fontface = "bold", fontfamily = "sans"))
  grid::popViewport()
  if (!is.null(plot)) {
    grid::pushViewport(grid::viewport(layout.pos.row = 2))
    print(plot, newpage = FALSE)
    grid::popViewport()
  }
  if (length(lines)) {
    grid::pushViewport(grid::viewport(layout.pos.row = 3))
    grid::grid.text(paste(lines, collapse = "\n"), x = 0, y = 1, just = c("left", "top"),
                    gp = grid::gpar(fontsize = 9.5, fontfamily = "sans", lineheight = 1.1))
    grid::popViewport()
  }
  grid::popViewport()
}

# cover: character vector of paragraphs. sections: list of
# list(heading, plot, text). Writes one cover page and one page per section.
write_report <- function(file, cover, sections) {
  grDevices::pdf(file, width = 8.5, height = 11, family = "Helvetica")
  on.exit(grDevices::dev.off())
  report_page("Biface outline analysis", NULL, cover)
  for (s in sections) report_page(s$heading, s$plot, s$text)
  invisible(file)
}

