# Elliptical Fourier analysis of closed outlines (Kuhl and Giardina formulas).
# The curve parameter t is cumulative chord length, with t = 0 at the first
# point. Specification: docs/specs/2026-11-17_app_rewrite_spec.md, section 7.2.

# Coefficients for harmonics 1..n_harmonics of a closed polygon (rows = points,
# first point not repeated). Returns list(a, b, c, d, x0, y0, perimeter), where
# x0 and y0 are the arc-length means of x and y.
efa_forward <- function(xy, n_harmonics) {
  K <- nrow(xy)
  if (n_harmonics < 1L) stop("At least one harmonic is required.")
  nxt <- c(2:K, 1L)
  dx <- xy[nxt, 1] - xy[, 1]
  dy <- xy[nxt, 2] - xy[, 2]
  dt <- sqrt(dx^2 + dy^2)
  if (any(dt < 1e-12)) stop("The outline contains repeated consecutive points.")
  t1 <- cumsum(dt)            # parameter at the end of each segment
  t0 <- t1 - dt               # parameter at the start of each segment
  per <- t1[K]
  h <- seq_len(n_harmonics)
  w <- 2 * pi * h / per
  dcos <- cos(outer(t1, w)) - cos(outer(t0, w))     # K x H
  dsin <- sin(outer(t1, w)) - sin(outer(t0, w))
  scale <- per / (2 * pi^2 * h^2)
  list(
    a = scale * colSums((dx / dt) * dcos),
    b = scale * colSums((dx / dt) * dsin),
    c = scale * colSums((dy / dt) * dcos),
    d = scale * colSums((dy / dt) * dsin),
    x0 = sum(dt * (xy[, 1] + xy[nxt, 1]) / 2) / per,
    y0 = sum(dt * (xy[, 2] + xy[nxt, 2]) / 2) / per,
    perimeter = per
  )
}

# Coefficient vector ordered a1..aH, b1..bH, c1..cH, d1..dH.
efa_vector <- function(coef) {
  H <- length(coef$a)
  stats::setNames(c(coef$a, coef$b, coef$c, coef$d),
                  paste0(rep(c("a", "b", "c", "d"), each = H), seq_len(H)))
}

# Specimens-by-4H coefficient matrix from a named list of point matrices.
efa_matrix <- function(shapes, n_harmonics) {
  m <- t(vapply(shapes, function(s) efa_vector(efa_forward(s, n_harmonics)),
                numeric(4L * n_harmonics)))
  rownames(m) <- names(shapes)
  m
}

# Parameter fraction (t / T) of each vertex of a closed polygon, 0 at vertex 1.
vertex_fractions <- function(xy) {
  dt <- sqrt(rowSums((xy[c(2:nrow(xy), 1L), , drop = FALSE] - xy)^2))
  c(0, cumsum(dt)[-nrow(xy)]) / sum(dt)
}

# Outline from a coefficient vector (a1..aH, b1.., c1.., d1..) using the first
# n_harmonics harmonics. Evaluated at n_points equally spaced parameter values,
# or at the parameter fractions `at` (t / T) when given.
efa_inverse <- function(vec, n_points = 200L, n_harmonics = length(vec) / 4, x0 = 0, y0 = 0, at = NULL) {
  H <- length(vec) / 4
  use <- seq_len(min(n_harmonics, H))
  a <- vec[use]; b <- vec[H + use]; cc <- vec[2 * H + use]; d <- vec[3 * H + use]
  theta <- if (is.null(at)) 2 * pi * (seq_len(n_points) - 1) / n_points else 2 * pi * at
  ct <- cos(outer(theta, use)); st <- sin(outer(theta, use))
  cbind(x = x0 + as.numeric(ct %*% a + st %*% b),
        y = y0 + as.numeric(ct %*% cc + st %*% d))
}

# Power of each harmonic, (a^2 + b^2 + c^2 + d^2) / 2, averaged over specimens,
# with cumulative shares of total power including and excluding the first
# harmonic. With no power beyond the first harmonic those shares are zero.
harmonic_power <- function(coef_matrix) {
  H <- ncol(coef_matrix) / 4
  idx <- function(h) c(h, H + h, 2 * H + h, 3 * H + h)
  power <- vapply(seq_len(H), function(h) mean(rowSums(coef_matrix[, idx(h), drop = FALSE]^2) / 2),
                  numeric(1))
  rest <- sum(power[-1])
  share_rest <- if (rest > 0) power[-1] / rest else rep(0, H - 1L)
  data.frame(harmonic = seq_len(H), power = power,
             cumulative_all = cumsum(power / sum(power)),
             cumulative_excluding_first = c(NA_real_, cumsum(share_rest)))
}

# Smallest number of harmonics whose cumulative power, excluding the first
# harmonic, reaches `target`; bounded to [lower, upper]. When no harmonic
# reaches the target (no power beyond the first), `lower` is returned.
choose_harmonics <- function(power_table, target = 0.99, lower = 6L, upper = 30L) {
  h <- which(power_table$cumulative_excluding_first >= target)[1]
  if (is.na(h)) h <- lower
  as.integer(min(max(h, lower), upper, nrow(power_table)))
}
# PDF report: the figures shown on screen with their interpretation text.
# Text is wrapped to the measured page width and continued on further pages
# when it does not fit, so no line is dropped.

REPORT <- list(page_w = 8.5, page_h = 11, body_w = 7.3, body_h = 10, heading_h = 0.5,
               line_h = 0.165, pad = 0.2, fontsize = 9.5, min_plot_h = 4.5)

report_gpar <- function() grid::gpar(fontsize = REPORT$fontsize, fontfamily = "sans", lineheight = 1.1)

# Width in inches of each string in the report's text font. Needs an open device.
text_width <- function(x) {
  if (length(x) == 0L) return(numeric(0))
  grid::pushViewport(grid::viewport(gp = report_gpar()))
  on.exit(grid::popViewport())
  vapply(x, function(s) grid::convertWidth(grid::stringWidth(s), "inches", valueOnly = TRUE), numeric(1), USE.NAMES = FALSE)
}

# Wrap paragraphs into lines no wider than `max_width` inches, with an empty
# line after each paragraph. A word wider than the line is split.
wrap_report_text <- function(paragraphs, max_width = REPORT$body_w - 0.1) {
  out <- character(0)
  space <- text_width(" ")
  for (p in paragraphs) {
    words <- strsplit(trimws(p), "[[:space:]]+")[[1]]
    words <- words[nzchar(words)]
    pieces <- character(0)
    for (w in words) {                       # split words that cannot fit on a line
      while (text_width(w) > max_width) {
        k <- nchar(w) - 1L
        while (k > 1L && text_width(substr(w, 1L, k)) > max_width) k <- k - 1L
        pieces <- c(pieces, substr(w, 1L, k)); w <- substr(w, k + 1L, nchar(w))
      }
      pieces <- c(pieces, w)
    }
    widths <- text_width(pieces)
    line <- character(0); used <- 0
    for (i in seq_along(pieces)) {
      add <- widths[i] + if (length(line)) space else 0
      if (length(line) && used + add > max_width) {
        out <- c(out, paste(line, collapse = " ")); line <- character(0); used <- 0; add <- widths[i]
      }
      line <- c(line, pieces[i]); used <- used + add
    }
    out <- c(out, if (length(line)) paste(line, collapse = " "), "")
  }
  out
}

# Number of text lines that fit on a page with and without a figure.
report_capacity <- function(with_plot) {
  space <- REPORT$body_h - REPORT$heading_h - REPORT$pad - if (with_plot) REPORT$min_plot_h else 0
  as.integer(floor(space / REPORT$line_h))
}

# Draw one page: heading, optional figure, and lines of text that fit.
report_page <- function(heading, plot = NULL, lines = character(0)) {
  grid::grid.newpage()
  text_height <- grid::unit(if (length(lines)) length(lines) * REPORT$line_h + REPORT$pad else 0, "inches")
  lay <- grid::grid.layout(3, 1, heights = grid::unit.c(grid::unit(REPORT$heading_h, "inches"), grid::unit(1, "null"), text_height))
  grid::pushViewport(grid::viewport(width = grid::unit(REPORT$body_w, "inches"), height = grid::unit(REPORT$body_h, "inches"), layout = lay))
  grid::pushViewport(grid::viewport(layout.pos.row = 1))
  grid::grid.text(heading, x = 0, just = "left", gp = grid::gpar(fontsize = 15, fontface = "bold", fontfamily = "sans"))
  grid::popViewport()
  if (!is.null(plot)) {
    grid::pushViewport(grid::viewport(layout.pos.row = 2))
    print(plot, newpage = FALSE)
    grid::popViewport()
  }
  if (length(lines)) {
    grid::pushViewport(grid::viewport(layout.pos.row = 3))
    grid::grid.text(paste(lines, collapse = "\n"), x = 0, y = 1, just = c("left", "top"), gp = report_gpar())
    grid::popViewport()
  }
  grid::popViewport()
}

# Draw a section on as many pages as its text needs. Returns the page count.
report_section <- function(heading, plot = NULL, paragraphs = character(0)) {
  lines <- wrap_report_text(paragraphs)
  if (length(lines) && !nzchar(lines[length(lines)])) lines <- lines[-length(lines)]
  first <- report_capacity(!is.null(plot))
  report_page(heading, plot, utils::head(lines, first))
  rest <- lines[-seq_len(min(first, length(lines)))]
  pages <- 1L
  per_page <- report_capacity(FALSE)
  while (length(rest)) {
    if (!nzchar(rest[1])) { rest <- rest[-1]; next }
    report_page(paste(heading, "(continued)"), NULL, utils::head(rest, per_page))
    rest <- rest[-seq_len(min(per_page, length(rest)))]
    pages <- pages + 1L
  }
  pages
}

# cover: character vector of paragraphs. sections: list of
# list(heading, plot, text). Writes the cover and one or more pages per section.
write_report <- function(file, cover, sections) {
  grDevices::pdf(file, width = REPORT$page_w, height = REPORT$page_h, family = "Helvetica")
  on.exit(grDevices::dev.off())
  report_section("Biface outline analysis", NULL, cover)
  for (s in sections) report_section(s$heading, s$plot, s$text)
  invisible(file)
}

