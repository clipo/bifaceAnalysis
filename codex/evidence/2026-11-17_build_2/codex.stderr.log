   149	  "A difference between collections is a difference between these samples. It can arise from the age of the artifacts, raw material, resharpening and breakage, how each collection was gathered, or local practice. The analysis does not distinguish among these.",
   150	  "The grey reference ranges show what reassigning these same specimens produces. They are not confidence or credible intervals, and a value outside its range is not evidence of a real difference between populations or places.",
   151	  "Left and right in an outline depend on which face was photographed. Unless every collection was photographed with a consistent face up, tick \"Analyse symmetric shapes\" before comparing collections.",
   152	  "Collections photographed or outlined by different people, at different image resolutions, or with different detection settings can differ for that reason alone. Edge roughness from image resolution affects the higher harmonics.",
   153	  "The PC axes describe variation among all specimens. They are not the directions that best separate the collections.",
   154	  "Every saved specimen, including unlabelled ones and those in collections too small to compare, is part of the alignment, the automatic choice of the number of harmonics, and the PCA. Adding, removing, or editing any specimen can therefore change these results."
   155	)
   156	
   157	COLLECTIONS_HELP <- "Collections are defined by group labels. Give each specimen the name of its collection, for example its site, in step 2 or step 3. Each collection needs at least 3 specimens, and at least 2 collections are needed for a comparison. A file of collection locations is optional and adds a map."
   158	
   159	text_collection_membership <- function(cd) {
   160	  sizes <- sprintf("%s (%d)", names(cd$sizes), as.integer(cd$sizes))
   161	  out <- sprintf("The comparison uses %d collections with %d specimens in total: %s.", length(cd$eligible), sum(cd$sizes), name_list(sizes))
   162	  left <- character(0)
   163	  if (cd$unlabelled > 0) left <- c(left, sprintf("%d specimen%s without a group label", cd$unlabelled, if (cd$unlabelled == 1) "" else "s"))
   164	  if (length(cd$small)) left <- c(left, sprintf("%d specimen%s in collections with fewer than %d specimens (%s)", sum(cd$small),
   165	                                                if (sum(cd$small) == 1) "" else "s", MIN_COLLECTION_SIZE, name_list(names(cd$small))))
   166	  if (length(left)) out <- c(out, sprintf("Left out of the collection results: %s.", name_list(left)))
   167	  out
   168	}
   169	
   170	text_collections <- function(cd, share, pairs, within) {
   171	  out <- c(text_collection_membership(cd),
   172	           "The plot shows the mean outline of each collection, rebuilt from the mean of its specimens' Fourier coefficients.")
   173	  if (is.finite(share$share)) {
   174	    r <- share$reference
   175	    out <- c(out, sprintf("Of the total variation in outline shape among these specimens, %s lies between the collection means and the rest within collections. If specimens were assigned to collections at random with the same sizes, the expected share would be %s (the number of collections minus 1, divided by the number of specimens minus 1). Random reassignment gave shares from %s to %s (central 95%% of values).",
   176	                          fmt_pct(share$share, 1), fmt_pct(share$expected, 1), fmt_pct(r$low, 1), fmt_pct(r$high, 1)))
   177	  } else out <- c(out, "The specimens in these collections have identical outlines, so no share of variation can be computed.")
   178	  np <- nrow(pairs)
   179	  far <- pairs[which.max(pairs$corrected_distance), ]; near <- pairs[which.min(pairs$corrected_distance), ]
   180	  zero <- pairs[pairs$corrected_distance == 0, , drop = FALSE]
   181	  out <- c(out,
   182	           "The raw distance between two collection means is larger on average than the distance between the means of the populations they were drawn from, because each mean carries sampling error. The corrected distance subtracts the expected size of that error. It assumes that specimens are independent of one another and does not account for the alignment and the number of harmonics having been fitted to these same specimens.",
   183	           if (np > 1) sprintf("The largest corrected distance is between %s and %s, and the smallest between %s and %s.", far$collection_a, far$collection_b, near$collection_a, near$collection_b),
   184	           if (nrow(zero)) sprintf("The corrected distance is 0 for %s: their raw distance is no larger than sampling error of the expected size produces. This does not show that the collections have the same mean shape.",
   185	                                   name_list(paste(zero$collection_a, "and", zero$collection_b))),
   186	           sprintf("There %s %d pair%s of collections. Pairs that share a collection are not independent of one another, and with several pairs an observed distance can fall outside its grey range through sampling alone.",
   187	                   if (np == 1) "is" else "are", np, if (np == 1) "" else "s"))
   188	  v <- stats::setNames(within$variance, within$collection)
   189	  out <- c(out, if (all(v > 0)) sprintf("Shape variance within collections is largest in %s and smallest in %s, a ratio of %s to 1. Variance from 3 to 5 specimens is imprecise. The bars show how much it changes when one specimen is left out; they are not intervals.",
   190	                                        names(v)[which.max(v)], names(v)[which.min(v)], fmt_num(max(v) / min(v), 1))
   191	         else if (any(v > 0)) sprintf("The specimens of %s do not differ in outline, so no ratio of variances is given.", name_list(names(v)[v == 0]))
   192	         else "No collection shows variation in outline shape among its specimens.")
   193	  c(out, "Colour the PCA plot by group label to see the specimens of each collection in the space of the principal components.")
   194	}
   195	
   196	text_collection_geo <- function(geo) {
   197	  if (!isTRUE(geo$available)) return(geo$reason)
   198	  r <- geo$reference
   199	  G <- (1 + sqrt(1 + 8 * geo$n_pairs)) / 2
   200	  c(sprintf("Each point is a pair of collections: %d located collections give %d pairs. Pairs that share a collection are not independent, so the points are not independent observations.", as.integer(G), as.integer(geo$n_pairs)),
   201	    sprintf("The correlation between corrected shape distance and geographic distance is %s. Reassigning the positions among the collections (%d assignments%s) gave values from %s to %s (central 95%%), with a mean of %s.",
   202	            fmt_num(geo$r), as.integer(geo$n_assignments), if (geo$n_assignments <= 5040) ", all possible" else ", chosen at random",
   203	            fmt_num(r$low), fmt_num(r$high), fmt_num(r$mean)),
   204	    "With a few locations, any pattern here can arise from the particular collections sampled. A few locations cannot establish a spatial pattern. Rounded or approximate coordinates change the geographic distances.")
   205	}
   206	
   207	text_collection_map <- function(window, not_located, unmatched) {
   208	  out <- if (isTRUE(window$ok)) c(
   209	    "Each point is a located collection, coloured by the selected summary. The colours show means of samples, and a mean from a small collection can differ from the mean of the population it came from by more than the differences between collections.",
   210	    "The coastlines and boundaries are low resolution and are for orientation only. A small window may show no boundaries, and outside the contiguous United States the map shows country borders only. The scale bar is correct along its own line of latitude and approximate elsewhere. Labels of nearby collections can overlap.")
   211	  else window$reason
   212	  if (length(not_located)) out <- c(out, sprintf("Collections without a location: %s.", name_list(not_located)))
   213	  if (length(unmatched)) out <- c(out, sprintf("Rows of the locations file that match no collection in the comparison: %s. Names must match the group labels exactly.", name_list(unmatched)))
   214	  out
   215	}
   182	# Returns list(available, reason, r, reference, n_assignments, n_pairs).
   183	shape_geo_correlation <- function(shape_d, geo_d, positions, n_perm = 999L, seed = 1L, min_located = MIN_LOCATED_FOR_DISTANCE) {
   184	  G <- nrow(shape_d)
   185	  distinct <- nrow(unique(round(positions, 12)))
   186	  if (G < min_located)
   187	    return(list(available = FALSE, reason = sprintf("The comparison of shape distance with geographic distance needs at least %d located collections. %d %s located.", min_located, G, if (G == 1) "is" else "are")))
   188	  if (distinct < 2)
   189	    return(list(available = FALSE, reason = "All located collections have the same position, so geographic distance does not vary."))
   190	  r <- matrix_correlation(shape_d, geo_d)
   191	  if (is.na(r))
   192	    return(list(available = FALSE, reason = "Shape distance does not vary between the located collections, so no correlation can be computed."))
   193	  perms <- if (G <= 7L) all_permutations(G) else with_seed(seed, t(vapply(seq_len(n_perm), function(i) sample.int(G), integer(G))))
   194	  vals <- apply(perms, 1, function(p) matrix_correlation(shape_d, geo_d[p, p]))
   195	  list(available = TRUE, r = r, reference = summarize_reference(vals), n_assignments = nrow(perms),
   196	       n_pairs = G * (G - 1L) / 2L)
   197	}
