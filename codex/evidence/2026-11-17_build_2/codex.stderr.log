try_text <- function(r) tryCatch({ t <- r(); if (is.character(t) && length(t) > 0 && all(nzchar(t))) "text" else "EMPTY" }, error = function(e) if (is_validation(e)) "message" else paste("ERROR:", conditionMessage(e)))

